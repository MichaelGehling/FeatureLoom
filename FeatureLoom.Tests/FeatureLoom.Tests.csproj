<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <StartupObject>FeatureLoom.DependencyInversion.ServiceRegistryTestProcess</StartupObject>

    <IsPackable>false</IsPackable>

    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <!-- Used directly by the Newtonsoft interop tests; on .NET it only arrived transitively via the test SDK. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Each test TFM exercises a different build of FeatureLoom.Core, so all variants show up side by side in Test Explorer:
      net10.0 -> Core net8.0
      net9.0  -> Core netstandard2.1
      net8.0  -> Core netstandard2.0
      net48   -> Core netstandard2.0 (real .NET Framework runtime)
    The test TFM is only the host runtime; the Core TFM is forced via SetTargetFramework.
    Override for a single run: dotnet test -f net10.0 -p:CoreTargetFramework=netstandard2.0
    Transitive references are disabled so the nearest-match rule cannot silently pick another Core build.
  -->
  <PropertyGroup Condition="'$(CoreTargetFramework)' == ''">
    <CoreTargetFramework Condition="'$(TargetFramework)' == 'net10.0'">net8.0</CoreTargetFramework>
    <CoreTargetFramework Condition="'$(TargetFramework)' == 'net9.0'">netstandard2.1</CoreTargetFramework>
    <CoreTargetFramework Condition="'$(TargetFramework)' == 'net8.0'">netstandard2.0</CoreTargetFramework>
    <CoreTargetFramework Condition="'$(TargetFramework)' == 'net48'">netstandard2.0</CoreTargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CoreTargetFramework)' != ''">
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <DependentTargetFramework Condition="'$(CoreTargetFramework)' == 'net8.0'">netstandard2.1</DependentTargetFramework>
    <DependentTargetFramework Condition="'$(DependentTargetFramework)' == ''">$(CoreTargetFramework)</DependentTargetFramework>
    <!-- e.g. CORE_NETSTANDARD2_0, usable in tests via #if to skip APIs not available in that Core build -->
    <DefineConstants>$(DefineConstants);CORE_$(CoreTargetFramework.ToUpperInvariant().Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <!-- References are unconditional so the outer (multi-target) evaluation used by VS also sees them; only the forced TFM is conditional. -->
  <ItemGroup>
    <ProjectReference Include="..\FeatureLoom.Core\FeatureLoom.Core.csproj">
      <SetTargetFramework Condition="'$(CoreTargetFramework)' != ''">TargetFramework=$(CoreTargetFramework)</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="..\FeatureLoom\FeatureLoom.csproj">
      <SetTargetFramework Condition="'$(DependentTargetFramework)' != ''">TargetFramework=$(DependentTargetFramework)</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="..\FeatureLoom.Web\FeatureLoom.Web.csproj">
      <SetTargetFramework Condition="'$(DependentTargetFramework)' != ''">TargetFramework=$(DependentTargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

</Project>
